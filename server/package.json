{
  "name": "learning-mentor-server",
  "version": "0.2.0",
  "private": true,
  "description": "Local MCP server and hooks for the Learning Mentor Claude plugin",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
