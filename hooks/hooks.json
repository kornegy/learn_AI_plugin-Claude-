{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/dist/hook.mjs", "session-start"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
